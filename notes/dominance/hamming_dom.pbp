% ---- symmetry breaking by dominance (scripts/dommerge.py) ----
% order: compare x_c1, then x_c2, then x_c3; an assignment with a 1 comes first
def_order lex3
  vars
    left u1 u2 u3;
    right v1 v2 v3;
    aux;
  end;
  def
    -4 u1 -2 u2 -1 u3 4 v1 2 v2 1 v3 >= 0;
  end;
  transitivity
    vars
      fresh_right w1 w2 w3;
    end;
    proof
      proofgoal #1
        pol 1 2 + 3 +;
      qed : -1;
    qed;
  end;
end;
